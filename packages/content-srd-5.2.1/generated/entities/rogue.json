      "class-feature",
      "rogue"
    ]
  },
  {
    "body": {
      "level": 5,
      "text": "When an attacker that you can see hits you with an attack roll, you can take a Reaction to halve the attack’s damage against you (round down)."
    },
    "id": "srd521.class-feature.rogue.uncanny-dodge",
    "kind": "class-feature",
    "name": {
      "en": "Uncanny Dodge"
    },
    "review": {
      "extractionApproved": true,
      "notes": "Uncanny Dodge extracted from the Rogue description.",
      "semanticsApproved": false,
      "status": "STRUCTURED",
