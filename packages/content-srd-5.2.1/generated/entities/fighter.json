      "text": {
        "nodes": [
          {
            "kind": "ParagraphNode",
            "text": "A Champion focuses on the development of martial prowess in a relentless pursuit of victory. Champions combine rigorous training with physical excellence to deal devastating blows, withstand peril, and garner glory. Whether in athletic contests or bloody battle, Champions strive for the crown of the victor."
          },
          {
            "kind": "ParagraphNode",
            "text": "Pursue Physical Excellence in Combat"
          }
        ],
        "title": "Champion"
      }
