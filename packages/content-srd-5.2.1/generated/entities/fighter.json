        "blocks": [
          "p0048-b002"
        ],
        "page": 48,
        "quoteHash": "bf67b1eaeb4b02b85c5bbeec4ba2c3e2f5d6264cbca1f43f7260344b4e923994",
        "sourceId": "wotc-srd-5.2.1-en"
      }
    ],
    "tags": [
