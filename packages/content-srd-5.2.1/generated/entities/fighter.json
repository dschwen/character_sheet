  {
    "body": {
      "automationLevel": "structured",
      "level": 1,
      "parentId": "srd521.class.fighter",
      "text": {
        "nodes": [
          {
            "kind": "ParagraphNode",
            "text": "You have honed your martial prowess and gain a Fighting Style feat of your choice (see “Feats”). Defense is recommended. Whenever you gain a Fighter level, you can replace the feat you chose with a different Fighting Style feat."
          }
        ],
        "title": "Fighting Style"
      }
    },
    "id": "srd521.class-feature.fighter.fighting-style",
    "kind": "class-feature",
    "name": {
      "en": "Fighting Style"
    },
