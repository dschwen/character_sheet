  {
    "body": {
      "automationLevel": "structured",
      "level": 15,
      "parentId": "srd521.class.barbarian",
      "text": {
        "nodes": [
          {
            "kind": "ParagraphNode",
            "text": "When you roll Initiative, you can regain all expended uses of Rage. After you regain uses of Rage in this way, you can’t do so again until you finish a Long Rest. In addition, your Rage is so fierce that it now lasts for 10 minutes without you needing to do anything to extend it from round to round. Your Rage ends early if you have the Unconscious condition (not just the Incapacitated condition) or don Heavy armor."
          }
        ],
        "title": "Persistent Rage"
      }
    },
    "id": "srd521.class-feature.barbarian.persistent-rage",
