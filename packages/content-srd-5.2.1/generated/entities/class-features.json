  {
    "body": {
      "automationLevel": "structured",
      "level": 2,
      "parentId": "srd521.class.barbarian",
      "text": {
        "nodes": [
          {
            "kind": "ParagraphNode",
            "text": "You can throw aside all concern for defense to attack with increased ferocity. When you make your first attack roll on your turn, you can decide to attack recklessly. Doing so gives you Advantage on attack rolls using Strength until the start of your next"
          },
          {
            "kind": "ParagraphNode",
            "text": "turn, but attack rolls against you have Advantage during that time."
          }
        ],
        "title": "Reckless Attack"
      }
    },
